# Site configuration for the preprocessing and supplementary scripts.
# Copy to .env, fill in your paths, then `source env.sh` before running or submitting anything.
# .env is gitignored. The analysis notebooks do not need any of this; they read data/ relative to the repo.

# BIDS root. Scripts expect <BIDS_ROOT>/outputs/BIDS_Penn/<sub>/ses-clinical01/anat/*_acq-mprage_T1w.nii.gz,
# <BIDS_ROOT>/metadata/metadata_drug_responsiveness.csv and <BIDS_ROOT>/software/apptainer_tmp
BIDS_ROOT=/path/to/BIDS_2026

# Project working tree. Scripts write to <PROJECT_DIR>/outputs/freesurfer,
# <PROJECT_DIR>/code/freesurfer and <PROJECT_DIR>/hcp_tractometry/...
PROJECT_DIR=/path/to/clinical_3T

# FreeSurfer 7.3.2 standalone Apptainer image and a FreeSurfer license file
FS_CONTAINER=/path/to/containers/freesurfer-7.3.2.sif
FS_LICENSE=/path/to/freesurfer/license.txt

# HCP-YA reference: subject table with ages, and the raw HCP1200 datalad tree
HCPYA_SUBJECTS_CSV=/path/to/hcpya/derivatives/hcpya_subjects.csv
HCPYA_RAW_DIR=/path/to/hcpya/hcp1200/HCP1200

# Conda environment with pyAFQ, neuroCombat etc. (see environment/requirements-preprocessing.txt)
CONDA_ENV=pyafq

# Cluster account used for `squeue -u` in the submission script
SLURM_USER=your_username
